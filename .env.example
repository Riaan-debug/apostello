# ──────────────────────────────────────────────────────────────
# Apostellō — environment
# Copy to .env.local for development. In production set these in
# Cloudflare Pages / Netlify → Site settings → Environment variables.
# ──────────────────────────────────────────────────────────────

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server only. NEVER expose this to the browser and never commit it.
# Used by the staff-PIN endpoint and the legacy migration script.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public site canonical URL (used for sitemap, robots, Open Graph)
NEXT_PUBLIC_SITE_URL=https://apostellocoffee.co.za
